# Copy to .env (never commit). Deployed backends load from AWS Secrets Manager.

# Auth (hackathon demo bearer — replace for production Cognito)
SENTINEL_API_TOKEN=dev-sentinel-token-change-me
SENTINEL_DEMO_USER_ID=demo-user-001
SENTINEL_DEMO_DEVICE_ID=demo-iphone-001

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
SENTINEL_STACK_NAME=SentinelAI-Hackathon
SENTINEL_SUSPEND_AT_UTC=2026-10-12T06:00:00Z
SENTINEL_MAINTENANCE_MODE=false

# OpenAI (LIVE when set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ClickHouse Cloud (LIVE when set)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# MongoDB Atlas (LIVE when set)
MONGODB_URI=
MONGODB_DATABASE=sentinel

# ElevenLabs (stretch — LIVE TTS when set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_PHONE=

# Feature flags
USE_LIVE_CLICKHOUSE=auto
USE_LIVE_MONGODB=auto
USE_LIVE_OPENAI=auto
GPS_TTL_DAYS=30
RESTAURANT_LOOKBACK_DAYS=14
